{
    "PukaLandLuckyStarEntrance": {
        "desc": "幸运星入口 — 只认「开始游戏」按钮，未进入界面时不盲敲空格",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 30000, // 等待加载结束 / 用户停留在幸运星界面上的总预算
        "focus": {
            "Node.Action.Starting": {
                "content": "幸运星：开始自动命中，请确保游戏窗口停在幸运星界面",
                "display": [
                    "log",
                    "toast"
                ]
            }
        },
        "next": [
            "PukaLandLuckyStarReset",
            "[JumpBack]SceneLoadingType1",
            "[JumpBack]SceneLoadingType2"
        ]
    },
    "PukaLandLuckyStarReset": {
        "desc": "重置幸运星回合计数",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "lucky_star_reset"
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PukaLandLuckyStarRound"
        ]
    },
    "PukaLandLuckyStarRound": {
        "desc": "新一局入口，按设定对局次数限制循环",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "lucky_star_round_gate",
                "custom_action_param": {
                    "repeat_count": 3 // default
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "PukaLandLuckyStarStart",
            "PukaLandLuckyStarCountdown"
        ]
    },
    "PukaLandLuckyStarStart": {
        "desc": "点击「开始游戏」",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "PukaLand/StartGameButton.png",
                "roi": [
                    918,
                    638,
                    96,
                    30
                ],
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 3000,
        "next": [
            "PukaLandLuckyStarCountdown"
        ]
    },
    "PukaLandLuckyStarCountdown": {
        "desc": "等待游戏开局倒计时结束，避免错过前几发",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 3000, // 开局倒计时等待，单位毫秒；由任务选项 PukaLandLuckyStarStartDelay 注入
        "next": [
            "PukaLandLuckyStarPlay"
        ]
    },
    "PukaLandLuckyStarPlay": {
        "desc": "对局中 — 第 1 次投掷，不做识别",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "LongPressKey",
            "param": {
                // VK_SPACE
                "key": [
                    32
                ],
                "duration": 500 // 按住时长，单位毫秒；首轮和补投节点需保持一致，可按实际情况调整
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 250,
        "next": [
            "PukaLandLuckyStarPlay2"
