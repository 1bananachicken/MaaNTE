                    68
                ],
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "volleyball_select_difficulty"
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 1000,
        "timeout": 15000,
