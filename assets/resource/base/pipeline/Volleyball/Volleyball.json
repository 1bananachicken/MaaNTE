{
    "VolleyballEntrance": {
        "desc": "自动排球入口并重置难度状态",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "volleyball_reset",
                "custom_action_param": {
                    "start_difficulty": 1
                }
            }
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [
            "VolleyballWaitDifficultySelection"
        ],
        "on_error": [
            "VolleyballTaskStop"
        ]
    },
    "VolleyballWaitDifficultySelection": {
        "desc": "等待难度选择界面并点击当前难度",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Volleyball/SelectDifficulty.png",
