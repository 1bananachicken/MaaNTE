{
    "LixiangguanRouteEntrance": {
        "desc": "理想馆钓点路线",
        "action": "DoNothing",
        "enabled": false,
        "max_hit": 3,
        "anchor": "LxgRestart",
        "next": [
            "LxgTeleport",
            "[JumpBack]SceneAnyEnterWorld"
        ],
        "on_error": [
            "LxgExit"
        ]
    },
    "LxgExit": {},
    "LxgTeleport": {
        "desc": "使用地图传送至理想馆",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "map_teleport_to_point",
                "custom_action_param": {
                    "teleport_point_id": "lixiangguan"
                }
            }
        },
        "next": [
            "LxgStartNavi"
        ],
        "on_error": [
            "[Anchor]LxgRestart"
        ]
    },
    "LxgStartNavi": {
        "desc": "开始寻路",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "Custom",
        "custom_action": "local_route_navigation",
        "custom_action_param": {
            "json_path": "FishNavigation",
            "route_name": "钓鱼路线",
            "segment_index": 1,
            "tolerance": 2,
            "angle_backend": "auto",
            "position_backend": "coordinate",
            "debug": false
        },
        "on_error": [
            "[Anchor]LxgRestart"
        ]
    }
}
