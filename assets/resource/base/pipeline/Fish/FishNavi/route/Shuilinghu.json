        "desc": "用于重复点击",
        "action":"Click",
        "target":"[Anchor]SlhClickNode"
    },
    "SlhOpenMap": {
        "desc": "打开地图",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "ClickKey",
        "key": [
            77 // M
        ],
        "post_wait_freezes": 100,
        "next": [
            "SlhOpenMapReference"
        ]
    },
    "SlhOpenMapReference": {
        "desc": "在地图中打开地图索引",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1047,
                    601,
                    129,
                    120
                ],
                "template": "map_teleport/map_index_icon.png"
            }
        },
        "action": "Click",
