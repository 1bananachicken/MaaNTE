{
    "ShuilinghuRouteEntrance": {
        "desc": "水菱湖钓点路线",
        "action": "DoNothing",
        "enabled": false,
        "max_hit": 3,
        "anchor": "SlhRestart",
        "next": [
            "SlhOpenMap",
            "[JumpBack]SceneAnyEnterWorld"
        ],
        "on_error": [
            "SlhExit"
        ]
    },
    "SlhExit": {},
