            "json_path": "FishNavigation",
            "route_name": "钓鱼路线",
            "segment_index": 2,
            "tolerance": 2,
            "angle_backend": "auto",
            "position_backend": "auto",
            "debug": false
        },
        "on_error": [
            "[Anchor]SlhRestart"
        ]
