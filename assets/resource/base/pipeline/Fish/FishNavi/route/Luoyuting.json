{
    "LuoyutingRouteEntrance": {
        "desc": "落雨庭钓点路线",
        "action": "DoNothing",
        "enabled": false,
        "max_hit": 3,
        "anchor": "LytRestart",
        "next": [
            //"LytOpenMap",
            "LytTeleport",
            "[JumpBack]SceneAnyEnterWorld"
        ],
        "on_error": [
            "LytExit"
        ]
    },
    "LytExit": {},
    "LytTeleport": {
        "desc": "使用地图传送至落雨庭",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "map_teleport_to_point",
                "custom_action_param": {//和喷泉任务同一个传送点
                    "teleport_point_id": "fountain"
                }
            }
        },
        "next": [
            "LytStartNavi"
        ],
        "on_error": [
            "[Anchor]LytRestart"
        ]
    },
    "LytStartNavi": {
        "desc": "开始寻路",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InWorld"
                ]
            }
        },
        "action": "Custom",
        "custom_action": "local_route_navigation",
        "custom_action_param": {
            "json_path": "FishNavigation",
            "route_name": "钓鱼路线",
            "segment_index": 4,
            "tolerance": 2,
            "angle_backend": "auto",
            "position_backend": "auto",
            "debug": false
        },
        "on_error": [
            "[Anchor]LytRestart"
        ]
    }
}
