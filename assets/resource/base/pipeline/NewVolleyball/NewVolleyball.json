{
    "NewVolleyballSkipIntro": {
        "desc": "入口前置：检测右上角跳过按钮并点击，等黑屏结束后进入视角初始化",
        "recognition": {
            "type": "DirectHit"
        },
        "action": "Custom",
        "custom_action": "volleyball_skip_intro",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 60000,
        "next": [
            "NewVolleyballEntrance",
            "NewVolleyballDone"
        ]
    },
    "NewVolleyballEntrance": {
        "desc": "入口：视角初始化，完成后进入接球循环",
        "recognition": {
            "type": "DirectHit"
        },
        "action": "Custom",
        "custom_action": "volleyball_view_setup",
        "custom_action_param": {
            "dy": 200
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 10000,
        "next": [
            "NewVolleyballReceiveLoop",
            "NewVolleyballDone"
        ]
    },
    "NewVolleyballDone": {
        "desc": "接球功能关闭或流程结束，停止任务",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopTask"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "NewVolleyballServeToss": {
        "desc": "发球：左键抛球，等待后进入重扣",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 1
            }
        },
        "pre_delay": 0,
        "post_delay": 2900,
        "rate_limit": 0,
        "timeout": 5000,
        "next": [
            "NewVolleyballSpike"
        ]
    },
    "NewVolleyballSpike": {
        "desc": "发球重扣：右键重扣",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 2
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 3000,
        "next": [
            "NewVolleyballReceiveLoop"
        ]
    },
    "NewVolleyballReceiveLoop": {
        "desc": "接球循环：检测结算→过场→闭环移动→space重扣",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 5000,
        "next": [
            "NewVolleyballResultScreenDetect",
            "NewVolleyballTransitionDetect",
            "NewVolleyballSpikeJump",
            "NewVolleyballMoveToLanding",
            "NewVolleyballReceiveLoop"
        ]
    },
    "NewVolleyballResultScreenDetect": {
        "desc": "检测结算画面（左下角离开按钮模板匹配），命中后点击对应按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "VolleyballWeekly/LeaveButton.png",
                "roi": [0, 600, 300, 120],
                "threshold": 0.9
            }
        },
        "action": "Custom",
        "custom_action": "volleyball_click_result",
        "custom_action_param": {
            "x": 46,
            "y": 674
        },
        "pre_delay": 0,
        "post_delay": 500,
        "rate_limit": 0,
        "timeout": 3000,
        "next": [
            "NewVolleyballDone"
        ]
    },
    "NewVolleyballTransitionDetect": {
        "desc": "检测过场动画（全屏蓝色），命中则进入回合间等待",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [400, 200, 480, 320],
                "method": 40,
                "lower": [90, 30, 100],
                "upper": [130, 255, 255],
                "count": 50000,
                "connected": false
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 3000,
        "next": [
            "NewVolleyballRoundWait"
        ]
    },
    "NewVolleyballRoundWait": {
        "desc": "回合间等待：过场动画出现→消失→角色回位",
        "recognition": {
            "type": "DirectHit"
        },
        "action": "Custom",
        "custom_action": "volleyball_round_wait",
        "custom_action_param": {
            "blue_ratio": 0.3,
            "wait_after": 1.5,
            "timeout": 10.0
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 15000,
        "next": [
            "NewVolleyballServeCheck",
            "NewVolleyballReceiveLoop"
        ]
    },
    "NewVolleyballServeCheck": {
        "desc": "检测主控是否站在底线上（主控发球），命中则进入发球流程",
        "recognition": {
            "type": "Custom",
            "custom_recognition": "volleyball_serve_detect"
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 3000,
        "next": [
            "NewVolleyballServeToss",
            "NewVolleyballReceiveLoop"
        ]
    },
    "NewVolleyballMoveToLanding": {
        "desc": "闭环移动：检测到落点后持续移动，到位后按左键传球",
        "recognition": {
            "type": "Custom",
            "custom_recognition": "volleyball_landing_detect",
            "custom_recognition_param": {
                "roi": [470, 190, 340, 340]
            }
        },
        "action": "Custom",
        "custom_action": "volleyball_move_to_landing",
        "custom_action_param": {
            "move_duration": 0.3,
            "wait_after_move": 0.1,
            "timeout": 3.0
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 5000,
        "next": [
            "NewVolleyballReceiveLoop"
        ]
    },
    "NewVolleyballSpikeJump": {
        "desc": "检测右下角space高亮（HSV+连通块面积筛选），命中则按空格起跳",
        "recognition": {
            "type": "Custom",
            "custom_recognition": "volleyball_spike_jump_detect",
            "custom_recognition_param": {
                "roi": [1060, 610, 100, 100]
            }
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 32
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 3000,
        "next": [
            "NewVolleyballSpikeWait"
        ]
    },
    "NewVolleyballSpikeWait": {
        "desc": "按空格后等待进入重扣窗口，按右键重扣，然后回到接球循环",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 2
            }
        },
        "pre_delay": 1200,
        "post_delay": 0,
        "rate_limit": 0,
        "timeout": 5000,
        "next": [
            "NewVolleyballReceiveLoop"
        ]
    }
}
