        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "BidKingRound"
        ]
    },
    "BidKingRound": {
        "desc": "单个完整拍卖轮次；max_hit 为总体拍卖轮数",
