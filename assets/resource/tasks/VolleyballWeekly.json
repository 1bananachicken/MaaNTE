{
    "task": [
        {
            "name": "AutoVolleyballWeekly",
            "label": "$task_auto_volleyball_weekly_label",
            "entry": "VolleyballWeeklyEntrance",
            "description": "$task_auto_volleyball_weekly_desc",
            "controller": [
                "Win32-Front"
            ],
            "group": [
                "HethereauHobbies"
            ],
            "pipeline_override": {
                "VolleyballCoreMatchEnd": {
                    "recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": [
                                "VolleyballWeekly/continue.png",
                                "Volleyball/ExitButton.png",
                                "Volleyball/NextButton.png",
                                "Volleyball/RestartButton.png"
                            ],
                            "roi": [
                                40,
                                525,
                                50,
                                150
                            ],
                            "threshold": 0.7
                        }
                    },
                    "next": [
                        "VolleyballWeeklyContinueMatch",
                        "VolleyballWeeklyLeagueOver"
                    ]
                },
                "VolleyballCoreServeCheck": {
                    "desc": "周常场地边框为黄色，发球底线检测同时接受蓝色与黄色（VolleyballServeDetect 的 line_color 参数）。参数必须嵌在 custom_recognition_param 下：写在 param 同级时框架会把 custom_recognition_param 传成字符串 \"null\"，识别每次抛 TypeError 导致发球检测恒不命中",
                    "recognition": {
                        "param": {
                            "custom_recognition": "volleyball_serve_detect",
                            "custom_recognition_param": {
                                "line_color": "both"
                            }
                        }
                    }
                }
            },
            "option": [
                "VolleyballWeeklySkipToPlay",
                "VolleyballWeeklyFirstCharacter",
                "VolleyballWeeklySecondCharacter",
                "VolleyballWeeklyUseLegacyMash",
                "VolleyballWeeklyViewZrPrep",
                "VolleyballWeeklyStartFromChampion"
            ]
        }
    ],
    "option": {
        "VolleyballWeeklySkipToPlay": {
            "type": "switch",
            "label": "$task_auto_volleyball_weekly_option_skip_to_play",
            "description": "$task_auto_volleyball_weekly_option_skip_to_play_desc",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "pipeline_override": {
                        "VolleyballWeeklyEntrance": {
                            "next": [
                                "VolleyballWeeklyIntroGate",
                                "VolleyballWeeklyPlay",
                                "VolleyballCoreViewSetup"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no"
                }
            ]
        },
        "VolleyballWeeklyStartFromChampion": {
            "type": "switch",
            "label": "$task_auto_volleyball_weekly_option_start_from_champion",
            "description": "$task_auto_volleyball_weekly_option_start_from_champion_desc",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "pipeline_override": {
                        "VolleyballWeeklyEntrance": {
                            "next": [
                                "VolleyballWeeklyChampionTree",
                                "VolleyballWeeklyStartMatch",
                                "VolleyballWeeklyChampionPromotion"
                            ]
                        },
                        "VolleyballWeeklyStartMatchAfterTeammates": {
                            "next": [
                                "VolleyballWeeklyIntroGate"
                            ],
                            "on_error": [
                                "VolleyballCoreViewSetup"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no"
                }
            ]
        },
        "VolleyballWeeklyUseLegacyMash": {
            "type": "switch",
            "label": "$task_auto_volleyball_weekly_option_use_legacy_mash",
            "description": "$task_auto_volleyball_weekly_option_use_legacy_mash_desc",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "pipeline_override": {
                        "VolleyballCoreViewSetup": {
                            "enabled": false
                        },
                        "VolleyballWeeklyPlay": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no",
                    "pipeline_override": {
                        "VolleyballCoreViewSetup": {
                            "enabled": true
                        },
                        "VolleyballWeeklyPlay": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "VolleyballWeeklyViewZrPrep": {
            "type": "switch",
            "label": "$task_auto_volleyball_weekly_option_zr_prep",
            "description": "$task_auto_volleyball_weekly_option_zr_prep_desc",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "$option_switch_case_yes",
                    "pipeline_override": {
                        "VolleyballCoreViewSetup": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "zr_prep": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "$option_switch_case_no",
                    "pipeline_override": {
                        "VolleyballCoreViewSetup": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "zr_prep": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "VolleyballWeeklyFirstCharacter": {
            "type": "select",
            "label": "$task_auto_volleyball_weekly_option_first_character",
            "description": "$task_auto_volleyball_weekly_option_first_character_desc",
            "default_case": "Character1",
            "cases": [
                {
                    "name": "Character1",
                    "label": "$task_auto_volleyball_weekly_character_1",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "first": 1
                            }
                        }
                    }
                },
                {
                    "name": "Character2",
                    "label": "$task_auto_volleyball_weekly_character_2",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "first": 2
                            }
                        }
                    }
                },
                {
                    "name": "Character3",
                    "label": "$task_auto_volleyball_weekly_character_3",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "first": 3
                            }
                        }
                    }
                }
            ]
        },
        "VolleyballWeeklySecondCharacter": {
            "type": "select",
            "label": "$task_auto_volleyball_weekly_option_second_character",
            "description": "$task_auto_volleyball_weekly_option_second_character_desc",
            "default_case": "Character2",
            "cases": [
                {
                    "name": "Character1",
                    "label": "$task_auto_volleyball_weekly_character_1",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "second": 1
                            }
                        }
                    }
                },
                {
                    "name": "Character2",
                    "label": "$task_auto_volleyball_weekly_character_2",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "second": 2
                            }
                        }
                    }
                },
                {
                    "name": "Character3",
                    "label": "$task_auto_volleyball_weekly_character_3",
                    "pipeline_override": {
                        "VolleyballWeeklySelectTeammates": {
                            "attach": {
                                "second": 3
                            }
                        }
                    }
                }
            ]
        }
    }
}
